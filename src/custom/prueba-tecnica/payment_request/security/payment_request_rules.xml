<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Regla global: nadie ve solicitudes de compañías que no tiene permitidas. -->
    <record id="rule_payment_request_company" model="ir.rule">
        <field name="name">Solicitudes de pago: compañías permitidas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Regla de grupo: el Solicitante solo ve sus propias solicitudes. -->
    <record id="rule_payment_request_requester_own" model="ir.rule">
        <field name="name">Solicitudes de pago: el solicitante solo ve las suyas</field>
        <field name="model_id" ref="model_payment_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_requester'))]"/>
    </record>

</odoo>
